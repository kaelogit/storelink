{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/dashboard/layout,_N_T_/dashboard/payout/layout,_N_T_/dashboard/payout/page,_N_T_/dashboard/payout"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/dashboard/payout/__PAGE__",
    "/dashboard/payout",
    "/dashboard",
    "/_index",
    "/_head"
  ]
}