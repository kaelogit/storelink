9:["$","p",null,{"className":"mt-2","children":["This policy describes how we handle personal data when you use the ",["$","strong",null,{"children":"StoreLink web storefront"}]," only (shopping, checkout, seller shop management on our shop domains). The StoreLink ",["$","strong",null,{"children":"mobile app"}]," may collect additional categories (for example seller verification flows). Its privacy disclosures are in the country-specific policy at"," ",["$","a",null,{"href":"https://storelink.ng/privacy/ng","className":"font-semibold text-emerald-800 underline underline-offset-2","children":"https://storelink.ng/privacy/ng"}],". If anything in this Shop notice conflicts with that document for data collected ",["$","em",null,{"children":"outside"}]," the Shop, the main policy controls for those activities."]}]
a:["$","div",null,{"className":"space-y-10 leading-relaxed","children":[["$","section",null,{"children":[["$","h2",null,{"className":"mb-3 text-xl font-bold text-gray-900","children":"1. Data we collect on the Shop"}],["$","ul",null,{"className":"list-disc space-y-2 pl-5","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Account & profile:"}]," email, password hash (held by our auth provider), name, phone, and profile fields you edit in the seller dashboard or account settings on the Shop."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Commerce:"}]," cart contents, delivery address you enter or select, order line items, amounts, currency, Store Coin redemptions where applicable, and Paystack references (we do not store full card numbers)."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Technical:"}]," IP address, device/browser type, pages viewed, and diagnostic logs needed for security and reliability."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Local storage on your device:"}]," we may store cart or billing-form helpers (for example delivery details you chose to save) in the browser; see section 4."]}]]}],["$","p",null,{"className":"mt-4 text-sm text-gray-600","children":["The Shop checkout experience does ",["$","strong",null,{"children":"not"}]," use the mobile app's government-ID or biometric verification flows. Those exist only where you use the native app and are covered under"," ",["$","a",null,{"href":"https://storelink.ng/privacy/ng","className":"font-semibold text-emerald-800 underline underline-offset-2","children":"https://storelink.ng/privacy/ng"}],"."]}]]}],["$","section",null,{"children":[["$","h2",null,{"className":"mb-3 text-xl font-bold text-gray-900","children":"2. How we use it"}],["$","ul",null,{"className":"list-disc space-y-2 pl-5","children":[["$","li",null,{"children":"To authenticate you, run checkout, create orders, and show order history."}],["$","li",null,{"children":"To pay sellers, detect fraud, reconcile payments, and meet accounting and legal obligations."}],["$","li",null,{"children":["To send ",["$","strong",null,{"children":"transactional"}]," messages: verification, password reset, order and payment confirmations, seller checkout alerts, and important service notices."]}],["$","li",null,{"children":"To improve the Shop using aggregated or de-identified analytics."}],["$","li",null,{"children":"Where you have opted in to marketing, to send promotional content you can withdraw from in settings."}]]}]]}],["$","section",null,{"children":[["$","h2",null,{"className":"mb-3 text-xl font-bold text-gray-900","children":"3. Sharing & processors"}],["$","p",null,{"children":["We do not sell your personal data. We share it with processors required to run the Shop, including"," ",["$","strong",null,{"children":"Supabase"}]," (database and authentication), ",["$","strong",null,{"children":"Paystack"}]," (payments), email delivery providers such as ",["$","strong",null,{"children":"Resend"}],", and hosting/analytics infrastructure (for example"," ",["$","strong",null,{"children":"Vercel"}],", ",["$","strong",null,{"children":"Google"}]," where measurement tags are enabled). They process data under contract and only to provide their service."]}],["$","p",null,{"className":"mt-3","children":"Sellers receive the order and contact details needed to fulfil your purchase. Do not misuse another user's information."}]]}],["$","section",null,{"children":[["$","h2",null,{"className":"mb-3 text-xl font-bold text-gray-900","children":"4. Cookies & browser storage"}],["$","p",null,{"children":["We use cookies and similar technologies for login sessions, security (for example CSRF protection), and preferences. We may use ",["$","code",null,{"className":"rounded bg-gray-100 px-1.5 py-0.5 text-sm","children":"localStorage"}]," for cart state and optional saved billing fields. You can clear site data in your browser; some features will not work without cookies or storage where technically required."]}]]}],"$L10","$L11","$L12","$L13","$L14","$L15"]}]
