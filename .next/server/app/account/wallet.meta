{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/account/layout,_N_T_/account/wallet/layout,_N_T_/account/wallet/page,_N_T_/account/wallet"
  },
  "segmentPaths": [
