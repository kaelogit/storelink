# Copy to `.env.local`. Never commit real secrets.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Marketplace hub (no trailing slash). Production: https://shop.storelink.ng
# Local dev: http://localhost:3000
# Supabase Auth → Redirect URLs must include: {NEXT_PUBLIC_SITE_URL}/auth/callback
NEXT_PUBLIC_SITE_URL=

# Apex domain used for seller subdomains: https://{slug}.{NEXT_PUBLIC_STOREFRONT_ROOT_DOMAIN}/
NEXT_PUBLIC_STOREFRONT_ROOT_DOMAIN=storelink.ng

# Subdomain reserved for the marketplace index (must match DNS + Vercel).
NEXT_PUBLIC_STOREFRONT_SHOP_SUBDOMAIN=shop

# Set to 1 in production when *.storelink.ng is wired; leave unset/0 for local path-only URLs on NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_STOREFRONT_SELLER_SUBDOMAIN_URLS=

# Google Maps JavaScript API key (Places Autocomplete / Maps JavaScript API enabled).
# Restrict by HTTP referrer (e.g. storelink.ng, localhost) in Google Cloud Console.
# Use the same Maps Platform project as mobile/native where possible so quotas and Place IDs align.
# Either name works on Vercel; duplicate values do not break anything. After adding/changing, redeploy
# the storefront project so the server can inject the key into the page.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_API_KEY=

# Launch market (ISO 3166-1 alpha-2). Compact UI fallback when city/state missing — align with profiles.location_country_code.
NEXT_PUBLIC_DEFAULT_MARKET_COUNTRY_CODE=NG

# Paystack (Nigeria live). Add split keys per country when you expand.
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
